# 1. DATABASE (PostgreSQL with Connection Pooling)
DATABASE_URL="postgresql://sportify_user:SportifySecurePass2026!@localhost:5432/sportify_db?schema=public&connection_limit=20&pool_timeout=10"

# 2. NEXTAUTH (Auth.js v5 JWT Session Security)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sportify_production_super_secret_jwt_key_min_32_characters_long_2026!"

# 3. PUBLIC FRONTEND ENVIRONMENT VARIABLES
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SPORTIFY.LABS"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# 4. COMMERCE & 3PL GATEWAY CREDENTIALS (MOCK / LIVE)
ADYEN_MERCHANT_ACCOUNT="SportifyEcomUS"
ADYEN_API_KEY="mock_adyen_api_key_for_local_development"
ADYEN_CLIENT_KEY="mock_adyen_client_key"

# 5. LOGGING & OBSERVABILITY
NODE_ENV="development"
LOG_LEVEL="info"
